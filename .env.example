# Telegram
TELEGRAM_BOT_TOKEN=           # @BotFather → /newbot
WEBHOOK_URL=https://bot.grip2peak.com

# LLM
GEMINI_API_KEY=               # aistudio.google.com (бесплатный)
GROQ_API_KEY=                 # console.groq.com (опционально)

# Maps & Geo
GOOGLE_MAPS_API_KEY=          # console.cloud.google.com

# Weather
WEATHERAPI_KEY=               # weatherapi.com (бесплатный план)
OPENWEATHER_API_KEY=          # openweathermap.org (fallback)

# Flights
TRAVELPAYOUTS_TOKEN=          # travelpayouts.com

# Flight tracking (live)
OPENSKY_USER=                 # opensky-network.org
OPENSKY_PASS=

# Database (не менять если используешь docker-compose)
DATABASE_URL=postgresql+asyncpg://travel:travel@db:5432/travel_agent

# Redis
REDIS_URL=redis://redis:6379/0

# App — ОБЯЗАТЕЛЬНО поменяй SECRET_KEY
SECRET_KEY=                   # python -c "import secrets; print(secrets.token_hex(20))"
ENVIRONMENT=production        # development | production
PORT=8001
